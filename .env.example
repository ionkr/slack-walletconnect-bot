# Slack Bot Configuration
# Get these from https://api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_APP_TOKEN=xapp-your-app-token

# WalletConnect Configuration
# Get your project ID from https://cloud.walletconnect.com
# Example Project ID (replace with your own):
WALLETCONNECT_PROJECT_ID=2aa1ada37fe9104d361674b337a37fe3

# Optional: WalletConnect Relay URL (default: wss://relay.walletconnect.com)
# WALLETCONNECT_RELAY_URL=wss://relay.walletconnect.com

# Supported Chains:
# - Ethereum (mainnet): Chain ID 1
# - BSC (Binance Smart Chain): Chain ID 56
# - Kaia: Chain ID 8217
# - Tron: Chain ID 0x2b6653dc (728126428)
